# Application Environment Configuration
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apsonic_cms
DB_USER=apsonic_user
DB_PASSWORD=your_db_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# pgAdmin Configuration
PGADMIN_EMAIL=admin@apsonic.com
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# JWT Authentication Security
# Base64 secret key (at least 256 bits)
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_hex_or_base64
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Refresh-token cookie. Secure=true requires HTTPS (localhost is exempted by
# browsers, so this can stay true even for local dev without a certificate).
COOKIE_SECURE=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APSONIC=INFO
