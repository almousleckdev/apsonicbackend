# Copy to .env.production on the server (chmod 600). NEVER commit the real file.

# --- Public address ------------------------------------------------------------------------------------
# Domain pointing at this server (A record). Caddy gets the HTTPS certificate for it automatically.
SITE_ADDRESS=www.example.com
PUBLIC_ORIGIN=https://www.example.com
ACME_EMAIL=ops@example.com

# --- Images (set by deploy.sh; tags are git commit SHAs) -------------------------------------------------
BACKEND_IMAGE=registry.example.com/apsonic/backend:CHANGEME
FRONTEND_IMAGE=registry.example.com/apsonic/frontend:CHANGEME

# --- Secrets: generate each with the command shown, never reuse a value ----------------------------------
JWT_SECRET=            # openssl rand -base64 48
DB_PASSWORD=           # openssl rand -base64 24 | tr -d '/+='
REDIS_PASSWORD=        # openssl rand -base64 24 | tr -d '/+='

# --- First administrator (only used while no active Super Admin exists; remove the password afterwards) --
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=   # >= 12 chars with upper, lower, digit and symbol

# --- Optional ------------------------------------------------------------------------------------------
DB_NAME=apsonic_cms
DB_USER=apsonic_user
# Local plain-HTTP testing only. In production keep these at their defaults.
# COOKIE_SECURE=false
# HTTP_PORT=80
# HTTPS_PORT=443
