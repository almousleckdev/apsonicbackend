# Copy to .env.production on the server (chmod 600). NEVER commit the real file.

# --- Public address ------------------------------------------------------------------------------------
# The ONE canonical address of the site. Caddy gets the HTTPS certificate for it automatically, but only once DNS
# for it points at this server and ports 80/443 are reachable.
SITE_ADDRESS=www.apsonic-moto.com
PUBLIC_ORIGIN=https://www.apsonic-moto.com
CANONICAL_HOST=www.apsonic-moto.com
ACME_EMAIL=ops@example.com   # a real mailbox of yours: Let's Encrypt sends expiry warnings here

# Optional: also serve the bare domain and redirect it to www. Only after apsonic-moto.com has its own DNS A record
# (it has none today), and then set  SITE_ADDRESS="www.apsonic-moto.com, apsonic-moto.com"
# REDIRECT_FROM_HOST=apsonic-moto.com

# --- Images (set by deploy.sh; tags are git commit SHAs) -------------------------------------------------
BACKEND_IMAGE=registry.example.com/apsonic/backend:CHANGEME
FRONTEND_IMAGE=registry.example.com/apsonic/frontend:CHANGEME

# --- Secrets: generate each with the command shown, never reuse a value ----------------------------------
JWT_SECRET=            # openssl rand -base64 48
PREVIEW_TOKEN_SECRET=  # openssl rand -base64 48  (signs page preview links; different from JWT_SECRET)
DB_PASSWORD=           # openssl rand -base64 24 | tr -d '/+='
REDIS_PASSWORD=        # openssl rand -base64 24 | tr -d '/+='

# --- First administrator (only used while no active Super Admin exists; remove the password afterwards) --
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=   # >= 12 chars with upper, lower, digit and symbol

# --- Optional ------------------------------------------------------------------------------------------
DB_NAME=apsonic_cms
DB_USER=apsonic_user
# Local plain-HTTP testing only. In production keep these at their defaults.
# COOKIE_SECURE=false
# HTTP_PORT=80
# HTTPS_PORT=443
